# ============================================
# Build Stage - compila apenas o Admin (sg-frontend)
# ============================================
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . ./
RUN npx ng build sg-frontend --configuration production

# ============================================
# Runtime Stage - nginx servindo só o Admin na raiz "/"
# ============================================
FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist/sg-frontend /usr/share/nginx/html
COPY nginx.admin.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/ || exit 1
