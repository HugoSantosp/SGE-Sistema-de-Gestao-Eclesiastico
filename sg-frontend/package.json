{
  "name": "sg-frontend",
  "version": "1.0.0",
  "description": "SGE - Sistema de Gerenciamento Eclesiástico (Frontend)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:site": "ng build sg-frontend --configuration site",
    "build:admin": "ng build sg-frontend --configuration production",
    "build:mm": "ng build meu-ministerio --configuration production",
    "build:all": "npm run build:admin && npm run build:site && npm run build:mm",
    "dev:site": "ng serve sg-frontend --configuration site",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --code-coverage --watch=false --browsers=ChromeHeadless",
    "test:e2e": "cypress open",
    "test:e2e:headless": "cypress run",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:all": "npm run test -- --watch=false && npm run test:e2e:headless",
    "test:ci": "npm run test:coverage && npm run test:e2e:headless",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "bootstrap": "^5.3.2",
    "@popperjs/core": "^2.11.8",
    "bootstrap-icons": "^1.11.2",
    "chart.js": "^4.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0",
    "@ionic/angular": "^7.7.0",
    "@capacitor/core": "^5.7.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.9.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.2.2",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/android": "^5.7.0",
    "@capacitor/ios": "^5.7.0",
    "cypress": "^13.6.0",
    "start-server-and-test": "^2.0.3",
    "@types/cypress": "^1.1.3"
  }
}
