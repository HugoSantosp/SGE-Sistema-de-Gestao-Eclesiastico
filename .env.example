# ============================================
# SGE - Variáveis de Ambiente (exemplo)
# ============================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#

# ============================================
# PostgreSQL
# ============================================
POSTGRES_DB=sge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ============================================
# Backend (Spring Boot)
# ============================================
BACKEND_PORT=8080

# OBRIGATÓRIO: Chave secreta JWT (mínimo 32 caracteres)
# Gere com: openssl rand -base64 48
JWT_SECRET=

# URL base da aplicação (usada em emails e links)
APP_BASE_URL=https://icertag.com.br

# Senha inicial do admin (será criado na primeira execução)
ADMIN_INITIAL_PASSWORD=12345678

# ============================================
# Email (SMTP) — opcional, para futuros emails
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================
# Frontend / Nginx
# ============================================
NGINX_PORT=80

# ============================================
# Sentry (monitoramento de erros) — opcional
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=https://icertag.com.br
